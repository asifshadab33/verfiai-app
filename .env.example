# Public Supabase project configuration (publishable key is not a secret)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: never expose via VITE_ prefix
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_DB_MIGRATION_URL=
TAVILY_API_KEY=
# Optional: Brave Search fallback (skipped when empty). GDELT, Wikipedia, Crossref, DuckDuckGo, OpenAlex, PubMed need no key.
BRAVE_SEARCH_API_KEY=
# Optional cache TTLs in hours (defaults: search/page/model/claim 24, citation 720, report 168)
SEARCH_CACHE_TTL_HOURS=
CLAIM_CACHE_TTL_HOURS=
REPORT_CACHE_TTL_HOURS=
# Fair-use ceilings are enforced in the database: 5/hour guests, 20/day signed-in accounts; verification cache 24h.
OPENROUTER_API_KEY=
PADDLE_SANDBOX_API_KEY=
PADDLE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
VITE_PAYMENTS_CLIENT_TOKEN=
LOVABLE_API_KEY=
